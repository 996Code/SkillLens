{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["chrome", "vite/client", "vitest/globals"]
  },
  "include": ["src", "vite.config.ts", "manifest.config.ts"]
}
